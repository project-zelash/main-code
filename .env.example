# Zelash runtime
# Select one provider: gemini, openai, anthropic, or bedrock.
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.7

# Google Gemini / Google AI Studio
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_ANALYSIS_MODEL=gemini-2.0-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional Google Custom Search for research tools
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# API server
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Pipeline workspaces and reports
AUTOMATION_WORKSPACE=./automation_workspace
AUTOMATION_REPORTS=./automation_workspace/reports
ORCHESTRATION_PROMPT=

# Browser and deployment automation
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
DEPLOYMENT_TIMEOUT=300
DEFAULT_PORT_RANGE=3000-8999

# MCP browser-use integration
MCP_SERVER_URL=ws://localhost:8765
MCP_SERVER_LOGGING_LEVEL=INFO
MCP_RESEARCH_TOOL_SAVE_DIR=./automation_workspace/mcp_research

# Next.js frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
